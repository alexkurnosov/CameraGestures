<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keys the generated Info.plist cannot express as INFOPLIST_KEY_ build settings.
  Xcode merges this file with the generated one (INFOPLIST_FILE = Info.plist).

  It declares the .cgsession session bundle as a document type, so the Files
  app shows a bundle as one document and offers this app to open it.
-->
<plist version="1.0">
<dict>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>ru.akurnosov.cameragestures.session</string>
			<key>UTTypeDescription</key>
			<string>CameraGestures Session</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cgsession</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>CameraGestures Session</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>ru.akurnosov.cameragestures.session</string>
			</array>
		</dict>
	</array>
	<!-- The app copies an opened session into its own storage. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
</dict>
</plist>
