workspace 'ModelTraining/ModelTraining.xcworkspace'
platform :ios, '16.0'
use_frameworks! :linkage => :static

# Stage 2: CameraGestures pod added alongside V1 pods.
# HandGestureTypes (V1) stays because HandsRecognizingModule / GestureModelModule /
# HandGestureRecognizingFramework all declare it as a transitive dependency.
# Both pods link fine — Swift modules are separately namespaced.
# The app's import statements still reference HandGestureTypes; the full swap
# (imports + Podfile) happens as one step once all four modules are ported (Stage 5).
pod 'CameraGestures', :path => '../../bindings/ios'
pod 'HandGestureTypes', :path => '../../iOS/HandGestureTypes'
pod 'HandsRecognizingModule', :path => '../../iOS/HandsRecognizing'
pod 'GestureModelModule', :path => '../../iOS/GestureModel'
pod 'HandGestureRecognizingFramework', :path => '../../iOS/HandGestureRecognizing'

target 'ModelTrainingApp' do
  project 'ModelTraining/ModelTrainingApp.xcodeproj'

  pod 'HandGestureRecognizingFramework', :path => '../../iOS/HandGestureRecognizing'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['SWIFT_INSTALL_OBJC_HEADER'] = 'YES'
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      config.build_settings['ENABLE_TESTABILITY'] = 'YES' if config.name == 'Debug'
    end
  end
  installer.aggregate_targets.each do |aggregate_target|
    user_project = aggregate_target.user_project
    user_project.native_targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      end
    end
    user_project.save
  end
end
